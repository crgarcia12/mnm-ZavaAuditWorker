<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <appSettings>
    <add key="RabbitMQ.Host" value="rabbitmq" />
    <add key="RabbitMQ.Port" value="5672" />
    <add key="RabbitMQ.VHost" value="/zavabank" />
    <add key="RabbitMQ.User" value="zava_app" />
    <add key="RabbitMQ.Password" value="zava_pass" />
    <add key="RabbitMQ.AuditQueue" value="audit.events" />
    <add key="RabbitMQ.DeadLetterExchange" value="zava.dlx" />
    <add key="Worker.PollIntervalMs" value="5000" />
    <add key="Database.ConnectionString" value="Server=sqlserver,1433;Database=ZavaBankDB;User ID=sa;Password=Zava123!;Encrypt=False;TrustServerCertificate=True;" />
  </appSettings>
</configuration>
